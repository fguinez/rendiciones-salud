# Copy to .env (gitignored) only if you need overrides. Never commit real keys.
# Prefer storing the API key in the macOS Keychain (see README).
# ANTHROPIC_API_KEY=
RENDICIONES_DATA_DIR=./data
RENDICIONES_PORT=8765
# auto | rules | llm
RENDICIONES_CLASSIFIER=auto
# module:function returning (colmena_client, chubb_client)
# RENDICIONES_PORTAL_FACTORY=rendiciones.automation.browser:factory   (o --clients playwright)
# Perfil del navegador (por defecto ./browser-profile) y canal (chrome si está instalado; chromium = el de Playwright)
# RENDICIONES_BROWSER_PROFILE=./browser-profile
# RENDICIONES_BROWSER_CHANNEL=chrome
